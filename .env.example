# =============================================================================
# .env.example  —  copy to .env and fill in your values
# =============================================================================

# ─── Azure AI Foundry ─────────────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4o

# ─── OpenAI (direct) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Azure OpenAI (alternative to direct OpenAI) ──────────────────────────────
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini          # deployment name
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ─── MCP Server ───────────────────────────────────────────────────────────────
# Option A: Connect to a running streamable-HTTP MCP server
# MCP_SERVER_URL=http://localhost:8080/mcp

# Option B: Launch MCP server as a subprocess (for OpenAI agent only)
# MCP_SERVER_COMMAND=python main.py

# ─── Tool Allow-list ──────────────────────────────────────────────────────────
# Comma-separated list of tool names that are permitted to execute.
# Leave empty to allow ALL tools.
ALLOWED_TOOLS=

# ─── Session Storage ──────────────────────────────────────────────────────────
SESSION_BACKEND=file        # memory | file | redis
SESSION_DIR=/tmp/agent_sessions
MAX_HISTORY_MESSAGES=40

# For Redis backend:
# REDIS_URL=redis://localhost:6379

# ─── Observability ────────────────────────────────────────────────────────────
# Azure Application Insights (recommended for production with Foundry)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# OTLP collector (Jaeger / Grafana / Datadog / etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Use console exporter for local development
OTEL_CONSOLE=true

OTEL_SERVICE_NAME=mcp-agent
LOG_LEVEL=INFO
JSON_LOGS=false             # set to true for production log aggregators
